{
  "enabledPlugins": {
    "vercel@claude-plugins-official": true
  },
  "permissions": {
    "deny": ["Read(./.env)", "Edit(./.env)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/prettier-nach-aenderung.sh",
            "timeout": 30,
            "statusMessage": "Prettier prüft die Datei …"
          }
        ]
      }
    ]
  }
}
